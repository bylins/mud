         Demonstrates the semantic-category selector (open string taxonomy authored in spells.xml). -->
    <feat id="kMaledictor" mode="kTesting">
        <talent_patches>
            <talent_patch category="curse" op="append">
                <action target="kTarSame">
                    <affects saving="kReflex" potency_weight="0.5">
                        <duration base="0" skill_divisor="6" min="2" max="6" />
