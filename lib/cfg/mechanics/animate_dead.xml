<!-- issue.animate-dead: warlock construct (animate-dead) parameters. Loaded via CfgManager
     as 'animate_dead'; reload live with `reload animatedead`. See the design in
     claude_1/OUTPUT. Stat scaling is per-creature off the cast competence C (skill_coeff +
     stat_coeff of kAnimateDead's potency_roll). 'luck' is omitted: mobs have no luck stat. -->
<animate_dead>
	<!-- headcount budget = min(<skill>, budget_cap) - sum of held-undead weights -->
	<control skill="kDarkMagic" budget_cap="75" />
	<!-- issue #4038: даровые аффекты поднятого. Порог называет само заклинание, а не вид, -->
	<!-- так что "оживить скелет" выдаёт их и обычному скелету тоже. min_skill считается по -->
	<!-- умению из <control> (магия тьмы). Снятию не подлежат, живут столько же, сколько чары. -->
	<grants>
		<grant spell="kAnimateSkeleton" min_skill="100" affect="kDetectInvisible" />
		<grant spell="kAnimateSkeleton" min_skill="100" affect="kInfravision" />
		<grant spell="kAnimateSkeleton" min_skill="120" affect="kFly" />
		<grant spell="kAnimateSkeleton" min_skill="140" affect="kDetectLife" />
		<grant spell="kAnimateSkeleton" min_skill="200" affect="kIceShield" />
	</grants>
	<creature vnum="0" id="kSkeleton" proto_vnum="3001" weight="8">
		<cost corpse_max_level="5" min_rating="0" />
		<scaling>
			<hp beta="0.25" mode="mult" cap="2.0" />
			<damage_dice beta="1.5" mode="add" cap="25" />
			<damage_size beta="0" mode="add" />
			<!-- die SIZE / magnitude (dN); 0 = off -->
			<damage_bonus beta="0" mode="add" />
			<!-- flat +B added to every hit (damroll); 0 = off -->
			<hitroll beta="0" mode="add" />
			<ac beta="0" mode="add" />
			<!-- lower AC = better; add a cap= to bound -->
			<skills beta="0" mode="add" cap="200" />
			<saving beta="0" mode="add" />
			<!-- all 4 saves; lower = better -->
			<armor beta="0" mode="add" />
			<morale beta="0" mode="add" />
			<initiative beta="0" mode="add" />
		</scaling>
	</creature>
