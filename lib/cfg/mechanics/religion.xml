<?xml version="1.0" encoding="utf-8"?>
<!--
issue #2689: кому молятся и кому приносят жертвы.

<recipient name="..." religion="..." spell="..."/>
name - имя в дательном падеже, как его набирают и как оно выводится: "жертвовать Перуну хлеб",
    "молиться Николе-Угоднику". Пробелов быть не должно (имя -- одно слово команды), поэтому
    составные имена пишутся через дефис. Можно набирать начало имени.
religion - kPoly (язычникам: команда "жертвовать") или kMono (христианам: команда "молиться").
spell - служебное заклинание из spells.xml, которое творит молитва или жертва. Что оно дает,
    описано в самом заклинании и в affects.xml.

Порядок записей -- порядок, в котором получатели перечисляются игроку.
-->
<religion>
	<recipient name="Яриле" religion="kPoly" spell="kSacrificeYarilo"/>
	<recipient name="Макоши" religion="kPoly" spell="kSacrificeMakosh"/>
	<recipient name="Перуну" religion="kPoly" spell="kSacrificePerun"/>
	<recipient name="Велесу" religion="kPoly" spell="kSacrificeVeles"/>
	<recipient name="Пресвятой-Богородице" religion="kMono" spell="kPrayerTheotokos"/>
	<recipient name="Николе-Угоднику" religion="kMono" spell="kPrayerNicholas"/>
	<recipient name="Илие-Пророку" religion="kMono" spell="kPrayerElijah"/>
	<recipient name="Георгию-Победоносцу" religion="kMono" spell="kPrayerGeorge"/>
</religion>
